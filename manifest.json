{
  "schemaVersion": 1,
  "id": "com.gaugedb.search",
  "name": "GaugeDB",
  "version": "0.2.1",
  "author": "GaugeDB",
  "description": "Save and compare Steam games, browse regional deals and reopen cached summaries offline.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "GaugeDB",
    "category": "Games",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "country": "NZ" },
    "schema": [
      { "key": "country", "type": "string", "label": "Store country (two-letter code)" }
    ]
  }
}
