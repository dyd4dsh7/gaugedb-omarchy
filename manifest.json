{
  "schemaVersion": 1,
  "id": "com.gaugedb.search",
  "name": "GaugeDB",
  "version": "0.2.3",
  "author": "GaugeDB",
  "license": "MIT",
  "description": "Search Steam games, compare regional prices, save favourites and browse deals from your bar. Includes offline summaries and ProtonDB links.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "GaugeDB",
    "category": "Games",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "country": "NZ" },
    "schema": [
      { "key": "country", "type": "string", "label": "Store country (two-letter code)" }
    ]
  }
}
